# Steel cloud browsers (server only). Without this, searches use labeled fixtures.
STEEL_API_KEY=
# Anthropic multimodal identification + streamed offer drafting (server only).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Configure with pnpm convex:dev; deploy functions with pnpm exec convex deploy.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Same random secret in Next.js and Convex environment. Protects server writes.
CONVEX_SERVER_SECRET=
# Clerk: activate its Convex integration; issuer is your Clerk Frontend API URL.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
# Optional browser QA: override the URL / installed Chromium executable.
QA_BASE_URL=
CHROMIUM_PATH=
# Convex environment only: one selected preview worker for the shared test backend.
# Production Convex must target the production worker. Blank disables dispatch.
WORKSPACE_WORKER_URL=
# Twilio (server only). Sends the "seller agreed on a price" SMS. Blank = logs only, no send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
